       VIEW-APPLICATIONS-SECTION SECTION.
           MOVE "--- Your Job Applications ---" TO WS-MESSAGE
           PERFORM PRINT-AND-LOG-SECTION
           STRING "Application Summary for "
               FUNCTION TRIM(WS-INPUT-USERNAME)
               DELIMITED BY SIZE INTO WS-MESSAGE
           PERFORM PRINT-AND-LOG-SECTION
           MOVE 0 TO WS-APPLICATION-COUNT
           PERFORM OPEN-APPLICATIONS-READ-SECTION
           PERFORM UNTIL WS-APPLICATIONS-EOF = 1
               PERFORM READ-APPLICATION-SECTION
               IF WS-APPLICATIONS-EOF = 0 AND
                   AP-USERNAME = WS-INPUT-USERNAME
                   ADD 1 TO WS-APPLICATION-COUNT
                   PERFORM PRINT-APPLICATION-SECTION
               END-IF
           END-PERFORM
           PERFORM CLOSE-APPLICATIONS-SECTION
           IF WS-APPLICATION-COUNT = 0
               MOVE "You have not applied for any jobs yet."
                   TO WS-MESSAGE
               PERFORM PRINT-AND-LOG-SECTION
           END-IF
           MOVE WS-APPLICATION-COUNT TO WS-NUMBER-TEXT
           STRING "Total Applications: "
               FUNCTION TRIM(WS-NUMBER-TEXT)
               DELIMITED BY SIZE INTO WS-MESSAGE
           PERFORM PRINT-AND-LOG-SECTION.

       PRINT-APPLICATION-SECTION SECTION.
           MOVE AP-JOB-ID TO WS-NUMBER-TEXT
           STRING "Job ID: " FUNCTION TRIM(WS-NUMBER-TEXT)
               DELIMITED BY SIZE INTO WS-MESSAGE
           PERFORM PRINT-AND-LOG-SECTION
           STRING "Job Title: " FUNCTION TRIM(AP-TITLE)
               DELIMITED BY SIZE INTO WS-MESSAGE
           PERFORM PRINT-AND-LOG-SECTION
           STRING "Employer: " FUNCTION TRIM(AP-EMPLOYER)
               DELIMITED BY SIZE INTO WS-MESSAGE
           PERFORM PRINT-AND-LOG-SECTION
           STRING "Location: " FUNCTION TRIM(AP-LOCATION)
               DELIMITED BY SIZE INTO WS-MESSAGE
           PERFORM PRINT-AND-LOG-SECTION
           MOVE "---" TO WS-MESSAGE
           PERFORM PRINT-AND-LOG-SECTION.
