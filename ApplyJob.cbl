       APPLY-JOB-SECTION SECTION.
           MOVE 0 TO WS-ALREADY-APPLIED
           PERFORM OPEN-APPLICATIONS-READ-SECTION
           PERFORM UNTIL WS-APPLICATIONS-EOF = 1
               PERFORM READ-APPLICATION-SECTION
               IF WS-APPLICATIONS-EOF = 0 AND
                   AP-USERNAME = WS-INPUT-USERNAME AND
                   AP-JOB-ID = WS-SELECTED-JOB
                   MOVE 1 TO WS-ALREADY-APPLIED
               END-IF
           END-PERFORM
           PERFORM CLOSE-APPLICATIONS-SECTION
           IF WS-ALREADY-APPLIED = 1
               MOVE "You have already applied for this job."
                   TO WS-MESSAGE
               PERFORM PRINT-AND-LOG-SECTION
               EXIT SECTION
           END-IF
           OPEN EXTEND APPLICATIONS-FILE
           IF WS-APPLICATIONS-STATUS = "35"
               OPEN OUTPUT APPLICATIONS-FILE
           END-IF
           IF WS-APPLICATIONS-STATUS NOT = "00"
               PERFORM APPLICATION-STORAGE-ERROR-SECTION
           END-IF
           MOVE 1 TO WS-APPLICATIONS-OPEN
           INITIALIZE APPLICATIONS-RECORD
           MOVE WS-INPUT-USERNAME TO AP-USERNAME
           MOVE WS-SELECTED-JOB TO AP-JOB-ID
           MOVE WS-SELECTED-TITLE TO AP-TITLE
           MOVE WS-SELECTED-EMPLOYER TO AP-EMPLOYER
           MOVE WS-SELECTED-LOCATION TO AP-LOCATION
           WRITE APPLICATIONS-RECORD
           IF WS-APPLICATIONS-STATUS NOT = "00"
               PERFORM APPLICATION-STORAGE-ERROR-SECTION
           END-IF
           PERFORM CLOSE-APPLICATIONS-SECTION
           STRING "Your application for "
               FUNCTION TRIM(WS-SELECTED-TITLE) " at "
               FUNCTION TRIM(WS-SELECTED-EMPLOYER)
               " has been submitted."
               DELIMITED BY SIZE INTO WS-MESSAGE
           PERFORM PRINT-AND-LOG-SECTION.

       OPEN-APPLICATIONS-READ-SECTION SECTION.
           MOVE 0 TO WS-APPLICATIONS-EOF
           OPEN INPUT APPLICATIONS-FILE
           EVALUATE WS-APPLICATIONS-STATUS
               WHEN "00" MOVE 1 TO WS-APPLICATIONS-OPEN
               WHEN "35" MOVE 1 TO WS-APPLICATIONS-EOF
               WHEN OTHER PERFORM APPLICATION-STORAGE-ERROR-SECTION
           END-EVALUATE.

       READ-APPLICATION-SECTION SECTION.
           READ APPLICATIONS-FILE
           EVALUATE WS-APPLICATIONS-STATUS
               WHEN "00" CONTINUE
               WHEN "10" MOVE 1 TO WS-APPLICATIONS-EOF
               WHEN OTHER PERFORM APPLICATION-STORAGE-ERROR-SECTION
           END-EVALUATE.

       CLOSE-APPLICATIONS-SECTION SECTION.
           IF WS-APPLICATIONS-OPEN = 1
               CLOSE APPLICATIONS-FILE
               MOVE 0 TO WS-APPLICATIONS-OPEN
               IF WS-APPLICATIONS-STATUS NOT = "00"
                   PERFORM APPLICATION-STORAGE-ERROR-SECTION
               END-IF
           END-IF.

       APPLICATION-STORAGE-ERROR-SECTION SECTION.
           STRING "Error: application storage failure, status "
               WS-APPLICATIONS-STATUS
               DELIMITED BY SIZE INTO WS-MESSAGE
           PERFORM PRINT-AND-LOG-SECTION
           PERFORM FINALIZE-SECTION
           MOVE 1 TO RETURN-CODE
           STOP RUN.
